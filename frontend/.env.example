# Copy this file to ".env" and restart the dev server.

# Point at your Django server (include the /api prefix — matches venue_booking/urls.py)
VITE_API_URL=http://localhost:8000/api

# "true"  → demo mode (built-in showcase venues, booking simulated locally)
# "false" → live mode (talks to your Django REST API)
VITE_USE_MOCK=false

# ---------------------------------------------------------------
# Venuva live mode checklist:
#   pip install django-cors-headers
#   INSTALLED_APPS += ["corsheaders"]
#   MIDDLEWARE = ["corsheaders.middleware.CorsMiddleware", ...]   # first
#   CORS_ALLOWED_ORIGINS = ["http://localhost:5173"]
# ---------------------------------------------------------------
